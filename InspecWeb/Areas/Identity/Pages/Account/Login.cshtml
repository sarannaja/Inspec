@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

    <div class="h-100 mt-5">
        <div class="col-sm-10 col-md-8 col-lg-6 mx-auto d-table h-100">
            <div class="d-table-cell align-middle">

               <div class="text-center">
                    <h3 class="prompt">
                        สำนักงานปลัดสำนักนายกรัฐมนตรี
                    </h3>
                    <h4 class="prompt">
                        Office of the Permanent Secretary, Prime Minister Office
                    </h4>
                  <img src="~/assets/fontend/images/logo.png"
                                     class="img-fluid rounded-circle" width="132" height="132" />

                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="m-sm-4">
                         <div class="text-center">
                                <h1 class="prompt">ระบบตรวจราชการอิเล็กทรอนิกส์
                                </h1>
                            </div>
                            <div class="text-center">
                                @* <img src="~/assets/fontend/images/logo.png"
                                     class="img-fluid rounded-circle" width="132" height="132" /> *@
                            </div>
                            <form method="post">
                                <div class="form-group">
                                    <label></label>
                                    <input asp-for="Input.Username" class="form-control form-control-lg" placeholder="กรอกชื่อผู้ใช้" />
                                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                                </div>
                          
                                <div class="form-group">
                                    <label></label>
                                    <div class="input-group">
                                        <input asp-for="Input.Password"
                                            class="form-control form-control-lg"
                                            placeholder="กรอกรหัสผ่าน"
                                            id="passwordInput" />
                                        <div class="input-group-append">
                                            <span id="togglePasswordBtn" class="input-group-text" style="cursor: pointer;">
                                                <i id="eyeIcon" class="fa fa-eye"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>

                                <div>
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label asp-for="Input.RememberMe">
                                                <input asp-for="Input.RememberMe" />
                                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-center mt-3">
                                    <button id="loginBtn" type="submit" class="btn btn-lg btn-primary" style="color: white;">เข้าสู่ระบบ</button>
                                    @*<button type="submit" class="btn btn-lg btn-primary">Sign in</button>*@

                                </div>
                                @Html.ValidationSummary(false, string.Empty, new { @class = "text-danger" })

                                <div class="text-center mt-1">
                                    <a href="/training/external/register">สมัครผู้ร่วมอบรม(สำหรับบุคคลภายนอก)</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

<div class="modal fade"
     id="pinModal"
     tabindex="-1"
     aria-labelledby="pinModalLabel"
     aria-hidden="true"
     data-show-pin="@(TempData["ShowPinModal"] ?? "false")">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="pinModalLabel">
                    ยืนยันตัวตน
                </h5>
            </div>


            <!-- Body -->
            <div class="modal-body text-center">

                <p>
                    กรุณากรอก PIN 6 หลัก
                </p>


                <!-- PIN Input -->
                <div class="input-group input-group-lg">

                    <input type="password"
                           id="pinInput"
                           class="form-control text-center"
                           maxlength="6"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="กรอก PIN 6 หลัก" />


                    <!-- Eye Button -->
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="togglePinBtn"
                            tabindex="-1">

                        <i class="fa fa-eye"
                           id="pinEyeIcon"></i>

                    </button>

                </div>


                <!-- PIN Error -->
                <div id="pinError"
                     class="text-danger mt-2"
                     style="display:none;">
                </div>

            </div>


            <!-- Footer -->
            <div class="modal-footer">

                <!-- Close -->
                <button type="button"
                        class="btn btn-danger"
                        id="closePinModalBtn">

                    ปิดกล่อง PIN

                </button>


                <!-- Confirm -->
                <button type="button"
                        class="btn btn-primary"
                        id="confirmPinBtn">

                    ยืนยัน

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js"></script>
}